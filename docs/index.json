{
  "@context": "https://schema.org",
  "@type": "Dataset",
  "@id": "https://brisecom.org/#catalogue",
  "name": "BRISECOM catalogue",
  "description": "Metadata of BRISECOM SL as JSON: services, prices, promotions, people, organisation and sites. A database without a server: git is the storage, a URL is the query.",
  "url": "https://brisecom.org/data/",
  "license": "https://creativecommons.org/licenses/by-nc-sa/4.0/",
  "version": "1.0",
  "dateModified": "2026-11-19",
  "publisher": {
    "@id": "https://brisecom.org/#organization"
  },
  "distribution": [
    {
      "@type": "DataDownload",
      "name": "organisation",
      "contentUrl": "https://javi-jimenez.github.io/brisecom-catalogue/data/organization.json",
      "description": "Legal identity, VAT, address, contact and the person behind it"
    },
    {
      "@type": "DataDownload",
      "name": "people",
      "contentUrl": "https://javi-jimenez.github.io/brisecom-catalogue/data/people.json",
      "description": "People with their ORCID and public profiles"
    },
    {
      "@type": "DataDownload",
      "name": "services",
      "contentUrl": "https://javi-jimenez.github.io/brisecom-catalogue/data/services.json",
      "description": "The service catalogue with prices (OfferCatalog)"
    },
    {
      "@type": "DataDownload",
      "name": "promotions",
      "contentUrl": "https://javi-jimenez.github.io/brisecom-catalogue/data/promotions.json",
      "description": "Time-bound offers, each with validUntil"
    },
    {
      "@type": "DataDownload",
      "name": "sites",
      "contentUrl": "https://javi-jimenez.github.io/brisecom-catalogue/data/sites.json",
      "description": "Registry of the sites BRISECOM operates"
    }
  ]
}
